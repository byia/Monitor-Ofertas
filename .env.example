# Token do BotFather
TELEGRAM_TOKEN=

# Seu chat_id do Telegram (pegue com @userinfobot). Deixe vazio para não restringir.
# Pode colocar mais de um separado por vírgula: 123456,789012
ALLOWED_USER_IDS=

# De quanto em quanto tempo o bot verifica os preços monitorados
CHECK_INTERVAL_HOURS=6

# Queda mínima (%) em relação à média histórica pra disparar notificação
MIN_ALERT_PERCENT=10

DB_PATH=ml_watcher.db
